# Copy to .env (never commit .env). Everything here has a safe default for local development.

DATABASE_URL=postgresql+psycopg://docuask:docuask@localhost:5434/docuask
API_KEYS=dev-key

# fake = no key, no network (tests, CI, first demo). openai | azure = real models.
LLM_PROVIDER=fake

# --- OpenAI (LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4.1-mini        # use a model your account can call
# EMBEDDING_MODEL=text-embedding-3-small   # 1536 numbers; the vector column is vector(1536)

# --- Azure OpenAI (LLM_PROVIDER=azure): the names are DEPLOYMENT names you created, not model names ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_CHAT_DEPLOYMENT=...
# AZURE_EMBEDDING_DEPLOYMENT=...

# Refusal gate. 0.95 is deliberately loose for the fake model. With real embeddings run
#   python -m docuask.evaluate
# and set it between "farthest answerable question" and "nearest unanswerable one".
MAX_DISTANCE=0.95